+++ b/common/src/main/java/com/shilapi/xcertplay/StarwishTrackKeys.kt
@@ -0,0 +1,25 @@
+package com.shilapi.xcertplay
+
+import android.view.KeyEvent
+import com.shilapi.xcertplay.airplay.CarPlayMediaButton
+
+internal class StarwishTrackKeys {
+    private val held = mutableSetOf<Pair<Int, Int>>()
+
+    fun handle(event: KeyEvent, enabled: Boolean): Boolean {
+        val button = when (event.keyCode) {
+            346 -> CarPlayMediaButton.PREVIOUS
+            347 -> CarPlayMediaButton.NEXT
+            else -> return false
+        }
+        val key = event.deviceId to event.keyCode
+        if (event.action == KeyEvent.ACTION_UP) return held.remove(key)
+        if (event.action != KeyEvent.ACTION_DOWN) return false
+        if (event.repeatCount > 0) return key in held
+        held.remove(key)
+        if (!enabled || !CarPlayBackgroundSession.active) return false
+        if (CarPlayBackgroundSession.snapshot()?.controller?.sendMediaButton(button) != true) return false
+        held.add(key)
+        return true
+    }
+}
